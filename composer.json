{
  "name": "matzed84/quiz-hero",
  "description": "Quiz-Hero PHP application and Hostinger deployment hook",
  "type": "project",
  "require": { "php": ">=8.3", "ext-pdo": "*", "ext-pdo_mysql": "*", "ext-mbstring": "*" },
  "autoload": { "classmap": ["scripts/hostinger/ComposerHook.php"] },
  "scripts": {
    "post-install-cmd": ["QuizHero\\Hostinger\\ComposerHook::deploy"],
    "post-update-cmd": ["QuizHero\\Hostinger\\ComposerHook::deploy"]
  },
  "config": { "allow-plugins": false }
}
