RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.(.*)$
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html?|php)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>

    <FilesMatch "\.(json|xml|txt)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>

    <FilesMatch "\.(css|js|mjs|woff2?|ttf)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" "expr=%{HTTP_HOST} =~ m#^(localhost|127\.0\.0\.1)(:[0-9]+)?$#"
        Header always set Pragma "no-cache" "expr=%{HTTP_HOST} =~ m#^(localhost|127\.0\.0\.1)(:[0-9]+)?$#"
        Header always set Expires "0" "expr=%{HTTP_HOST} =~ m#^(localhost|127\.0\.0\.1)(:[0-9]+)?$#"
        Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{HTTP_HOST} !~ m#^(localhost|127\.0\.0\.1)(:[0-9]+)?$#"
    </FilesMatch>

    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico)$">
        Header always set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
